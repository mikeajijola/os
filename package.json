{
  "name": "@mikeajijola/os",
  "version": "0.1.0",
  "private": true,
  "description": "A contract-enforcing Zig agent engine for native and WebAssembly hosts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeajijola/os.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./sdk/types/os-node.d.ts",
        "default": "./sdk/os-node.js"
      },
      "default": {
        "types": "./sdk/types/os-browser.d.ts",
        "default": "./sdk/os-browser.js"
      }
    },
    "./node": {
      "types": "./sdk/types/os-node.d.ts",
      "default": "./sdk/os-node.js"
    },
    "./browser": {
      "types": "./sdk/types/os-browser.d.ts",
      "default": "./sdk/os-browser.js"
    },
    "./durable-world": {
      "types": "./sdk/types/durable-world.d.ts",
      "default": "./sdk/durable/world.mjs"
    }
  },
  "scripts": {
    "build:native": "zig build native && node scripts/install-artifacts.mjs native",
    "build:wasm": "zig build wasm && node scripts/install-artifacts.mjs wasm",
    "test:native": "node sdk/tests/test-agent-contract.mjs native && node tests/kernel-contract.mjs",
    "test:wasm": "node --experimental-wasm-jspi sdk/tests/test-agent-contract.mjs wasm",
    "test:types": "tsc --noEmit --strict --module NodeNext --target ES2022 tests/types.mts",
    "test": "npm run test:native && npm run test:wasm && npm run test:types"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "files": [
    "sdk/*.js",
    "sdk/*.node",
    "sdk/os-core.wasm",
    "sdk/types",
    "sdk/durable/world.mjs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
